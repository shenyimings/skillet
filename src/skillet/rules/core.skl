# skillet core rule set.
#
# Each rule reads as the claim it encodes; every firing is auditable back to the facts and
# source spans that satisfied it. Predicates come from three extractors:
#   static (literals/frontmatter/includes): MentionsExternalHost, MentionsSensitivePath,
#       MentionsEnvKey, MentionsCommand, PipesToShell, OpaqueBlob, WildcardTool,
#       UnattendedPermissionMode, Includes, File, InFile
#   semantic (labeller): Imperative, TargetsSensitive, Egress, AuthorityClaim,
#       Concealment, Persistence  (all chunk-scoped, joined via InFile)
#
# ---------------------------------------------------------------------------------------
# Library: cross-file and same-file reachability. This is the closure that lets an attack
# split across files be seen as one chain.

reaches(C1, C2) :- in_file(C1, F), in_file(C2, F).
reaches(C1, C2) :- in_file(C1, F1), includes(F1, F2), in_file(C2, F2).
reaches(C1, C3) :- reaches(C1, C2), reaches(C2, C3).

# A chunk's file has an external egress sink (static evidence in the same file).
file_egresses(C) :- in_file(C, F), mentions_external_host(F, _).
file_egresses(C) :- in_file(C, F), pipes_to_shell(F).

# A file reads something sensitive (static evidence: a credential path or an env secret).
sensitive_file(F) :- mentions_sensitive_path(F, _).
sensitive_file(F) :- mentions_env_key(F, _).

# ---------------------------------------------------------------------------------------
# Exfiltration: a sensitive-data read that reaches an egress. The classic multi-file
# credential-theft chain; neither half is alarming alone.

rule exfil_chain_semantic severity=HIGH emits=E1 min_confidence=0.4 {
    targets_sensitive(A)
    reaches(A, B)
    egress(B)
    => "a chunk handling sensitive data reaches a chunk that transmits data outward"
}

rule exfil_chain_static severity=HIGH emits=E1 {
    targets_sensitive(A)
    reaches(A, B)
    file_egresses(B)
    => "sensitive-data handling reaches a file with an external egress sink"
}

# Fully static, no LLM required: one file both reads a sensitive resource and names an
# external endpoint. Language-agnostic, so a rewrite in Go/Rust/Java trips it identically.
rule exfil_same_file_static severity=HIGH emits=E1 {
    sensitive_file(F)
    mentions_external_host(F, _)
    => "a single file both reads a sensitive resource and names an external endpoint"
}

# ---------------------------------------------------------------------------------------
# Prompt injection: an authority claim combined with concealment is the textbook shape of
# an instruction aimed at the agent rather than the user ("ignore prior rules; do not tell
# the user"). Same file, so it is one coherent instruction.

rule injection_conceal severity=HIGH emits=P1 min_confidence=0.4 {
    authority_claim(A)
    in_file(A, F)
    concealment(B)
    in_file(B, F)
    => "authority claim paired with a request to conceal behaviour from the user"
}

# Concealment attached to an outward transmission: exfiltrate, and stay quiet about it.
rule silent_egress severity=HIGH emits=P3 min_confidence=0.4 {
    egress(A)
    reaches(A, B)
    concealment(B)
    => "data is transmitted outward while the user is asked not to be told"
}

# ---------------------------------------------------------------------------------------
# Persistence: a skill that asks to write to agent memory or config outlives its task.

rule persistence_write severity=MEDIUM emits=P4 min_confidence=0.4 {
    persistence(A)
    => "the skill asks to persist state into agent memory or configuration"
}

rule persistence_static severity=MEDIUM emits=P4 {
    in_file(C, F)
    mentions_sensitive_path(F, "agent_memory")
    imperative(C)
    => "an instruction targets agent memory/config files (CLAUDE.md, .claude, AGENTS.md)"
}

# ---------------------------------------------------------------------------------------
# Over-privilege: broad or unattended capability grants. Static-only, high precision.

rule wildcard_tool severity=MEDIUM emits=PE1 {
    wildcard_tool(S, _)
    => "the skill grants a wildcard tool permission (e.g. Bash(*))"
}

rule unattended_mode severity=HIGH emits=PE1 {
    unattended_permission_mode(S, _)
    => "the skill runs in an unattended permission mode (bypassPermissions / acceptEdits)"
}

# ---------------------------------------------------------------------------------------
# Supply chain: remote code pulled in and run, or an encoded payload with an exec pathway.

rule pipe_to_shell severity=HIGH emits=SC2 {
    pipes_to_shell(F)
    => "remote content is piped directly into a shell (curl ... | sh)"
}

rule obfuscated_payload severity=MEDIUM emits=SC3 {
    opaque_blob(F, _)
    mentions_command(F, "base64_decode")
    => "an encoded blob co-occurs with a decode step: possible hidden payload"
}
