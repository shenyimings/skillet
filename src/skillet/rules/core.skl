# skillet v2 rule set — composition over primitives.
#
# Facts are primitives (Read/Write/Exec/Net/Flow/Claim/Declares/Obfuscation over a small
# resource lattice), emitted by BOTH the static scanner and the LLM labeller. Rules compose
# them, so a novel resource or channel that either tier classifies into the vocabulary is
# caught by the same rule — no per-attack predicate. Every alert is still traceable to the
# facts and source spans that produced it.
#
# Convention: Capitalized = variable, snake_case = predicate (PascalCased to the fact name),
# _ = fresh don't-care, bare lowercase = constant.

# ---------------------------------------------------------------------------------------
# Reachability. Flow is the taint/control graph: same file, across an include edge, and
# transitively. co_in_skill is weak reachability — two loci merely in the same package,
# with no edge linking them (the agent still loads the whole skill as one unit).
flow(A, B) :- in_file(A, F), in_file(B, F).
flow(A, B) :- in_file(A, F1), includes(F1, F2), in_file(B, F2).
flow(A, C) :- flow(A, B), flow(B, C).
# Weak reachability: two loci merely in the same package, no edge. Used only where the
# source is a strong secret, so it does not blanket every read+send pair.
co_in_skill(A, B) :- in_file(A, X), in_file(B, Y).

# ---------------------------------------------------------------------------------------
# Exfiltration: a STRONG secret (a credential file, a broad environment harvest, a cloud-
# metadata read, or anything the LLM judged sensitive) that reaches an outward send.
# "Outward" is Net(out) for EVERY channel — http, DNS, scp, git push, email. Reading one
# named API key and calling an API is NOT a strong secret, so it does not fire here — that
# is the commonest benign pattern and is left to the LLM to adjudicate. `flow` is same-file
# or an include edge, never mere co-presence.
rule exfiltration severity=HIGH emits=E1 min_confidence=0.4 {
    strong_secret(A)
    flow(A, B)
    net(B, out)
    => "a credential or private resource is read and then sent outward"
}

# A strong secret and an outward send that merely co-exist in the same skill, with no
# dataflow edge linking their files. Circumstantial, so MEDIUM — but a credential-file read
# is rare enough in a benign skill that co-presence with egress is worth surfacing. (This is
# gated on strong_secret, not any read, so it does not fire on ordinary API-key + request.)
rule exfiltration_copresent severity=MEDIUM emits=E1 min_confidence=0.4 {
    strong_secret(A)
    co_in_skill(A, B)
    net(B, out)
    => "the skill reads a credential in one file and can send data outward from another"
}

# ---------------------------------------------------------------------------------------
# Remote code execution and reverse shells. All require the two halves at the SAME locus,
# so "downloads a dependency here, runs the build there" (ordinary dev work) does not fire.
rule rce severity=HIGH emits=SC2 {
    pipe_to_shell(A)
    => "remote content is piped directly into a shell (curl ... | sh)"
}
rule reverse_shell severity=HIGH emits=SC2 min_confidence=0.4 {
    exec(A)
    net(A, out)
    attr(A, channel, socket)
    => "one locus spawns a process and opens a raw outbound socket (reverse shell)"
}
rule exec_obfuscated severity=HIGH emits=SC3 min_confidence=0.4 {
    exec(A)
    obfuscation(A, encoded)
    => "one locus both executes and holds an encoded payload"
}

# ---------------------------------------------------------------------------------------
# Prompt injection / agent manipulation (mostly LLM-supplied claims).
rule injection severity=HIGH emits=P1 min_confidence=0.4 {
    claim(A, authority)
    flow(A, B)
    claim(B, conceal)
    => "an authority claim is paired with a request to conceal behaviour from the user"
}
rule conceal_directive severity=MEDIUM emits=P4 min_confidence=0.5 {
    claim(A, conceal)
    => "the skill asks the agent to hide its instructions or actions from the user"
}
rule deception severity=HIGH emits=P4 min_confidence=0.4 {
    claim(A, deceive)
    => "the skill misrepresents to the user what it does"
}

# ---------------------------------------------------------------------------------------
# Persistence.
rule persistence_write severity=MEDIUM emits=P4 min_confidence=0.4 {
    write(A, agent_state)
    attr(A, write_kind, shell_rc)
    => "the skill writes to a shell startup file (persistence across sessions)"
}
rule persistence_claim severity=MEDIUM emits=P4 min_confidence=0.4 {
    claim(A, persist)
    => "the skill declares its instructions standing or persistent"
}

# ---------------------------------------------------------------------------------------
# Over-privilege (declared capability the purpose does not justify).
rule overprivilege_wildcard severity=MEDIUM emits=PE1 {
    declares(S, wildcard)
    => "the skill grants a wildcard tool permission (e.g. Bash(*))"
}
rule overprivilege_unattended severity=HIGH emits=PE1 {
    declares(S, unattended)
    => "the skill runs in an unattended permission mode (bypassPermissions / acceptEdits)"
}

# ---------------------------------------------------------------------------------------
# The evasion attempt is itself the finding.
rule evasion_confusable severity=HIGH emits=P2 {
    obfuscation(A, confusable)
    => "security-relevant text is obfuscated with look-alike characters"
}
rule evasion_zero_width severity=HIGH emits=P2 {
    obfuscation(A, zero_width)
    => "security-relevant text is obfuscated with zero-width characters"
}
rule evasion_padding severity=MEDIUM emits=P2 {
    obfuscation(A, padding)
    => "a large whitespace run is used to hide content from review"
}
rule evasion_oversize severity=MEDIUM emits=SC3 {
    obfuscation(A, oversize)
    => "an oversized file exceeds the scan cap and may hide a payload past it"
}
